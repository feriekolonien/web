---
links:
    - text: Om oss
      url: /om-oss/
    - text: Bilder
      url: /bilder/
    - text: Historien
      url: /historien/
    - text: Kontakt
      url: /kontakt/
    - text: Støtte
      url: /grasrot/
---

<nav class="mx-center mx-auto flex max-w-6xl flex-col py-5 sm:flex-row md:items-center">
    <div class="mr-auto flex w-full sm:w-auto">
        <a class="mr-auto" href="/">
            {{ comp.image({
                width: 160,
                height: 40,
                src: "/assets/logo.png",
                altText: "Filtvet feriekoloni"
            }) }}
        </a>
    </div>
    <ul class="mx-3 mt-4 grid grid-cols-3 items-baseline gap-3 text-slate-900 sm:mt-0 sm:flex sm:space-x-6">
        {{ for link of links }}
            {{set isActive = url && url.startsWith(link.url) }}
            <li class="flex justify-center sm:justify-start">
                <a
                    class="
                        font-bold
                        relative
                        pb-1
                        transition-colors
                        duration-200
                        ease-in-out
                        hover:text-slate-600
                        text-center sm:text-left
                        text-sm sm:text-base
                        {{ if isActive }}
                            text-primary-2
                            after:w-full
                        {{ else }}
                            text-slate-900
                            hover:after:w-full
                        {{ /if }}
                        after:content-['']
                        after:absolute
                        after:bottom-0
                        after:left-0
                        after:h-0.5
                        {{ if isActive }}after:w-full after:bg-slate-900{{ else }}after:bg-slate-600 after:w-0{{ /if }}
                        after:transition-all
                        after:duration-300
                        after:ease-out
                    "
                    href="{{ link.url }}"
                    {{ if isActive }}aria-current="page"{{ /if }}
                >
                    {{ link.text }}
                </a>
            </li>
        {{ /for }}
        <!-- Registration link (hidden until countdown expires) -->
        <li id="registration-nav-link" class="hidden justify-center sm:justify-start">
            <a
                class="
                    bg-gradient-to-r from-[#2C72AC] to-[#46B3D9]
                    text-white
                    px-2 py-2 sm:px-6 sm:py-3 rounded-lg
                    font-bold
                    transition-all duration-200
                    hover:shadow-lg hover:scale-105
                    text-center sm:text-left
                    text-sm sm:text-base
                    w-full sm:w-auto
                "
                href="/register/"
            >
                <span id="registration-nav-label">Påmelding</span>
            </a>
        </li>
    </ul>
</nav>

<script type="module">
import { getSeasonPhase, SEASON_PHASE } from "/assets/season.js";

(function() {
    const season = window.feriekolonienSeason;
    const registrationLink = document.getElementById('registration-nav-link');
    const registrationLabel = document.getElementById('registration-nav-label');

    function checkRegistrationStatus() {
        const phase = getSeasonPhase(season);
        const registrationIsAvailable = phase === SEASON_PHASE.REGISTRATION_OPEN ||
            phase === SEASON_PHASE.WAITLIST;

        if (registrationLink) {
            registrationLink.classList.toggle('hidden', !registrationIsAvailable);
            registrationLink.classList.toggle('flex', registrationIsAvailable);
        }

        if (registrationLabel) {
            registrationLabel.textContent = phase === SEASON_PHASE.WAITLIST
                ? 'Venteliste'
                : 'Påmelding';
        }
    }

    // Check immediately and then every minute
    checkRegistrationStatus();
    setInterval(checkRegistrationStatus, 60000);
})();
</script>
